# =============================================================================
# iLink-Router - WeChat Clawbot Router Configuration
# =============================================================================
# Copy this file to `.env` and adjust values.
#
# GitHub: https://github.com/ZHYxulei/iLink-Router
# iLink Protocol: https://www.wechatbot.dev/zh/protocol
# SDK: @wechatbot/wechatbot (https://www.npmjs.com/package/@wechatbot/wechatbot)

# --- Database ----------------------------------------------------------------
# Default: SQLite (zero-config).
#
# To switch to PostgreSQL or MySQL, also edit the `provider` line in
# prisma/schema.prisma (Prisma requires it to be a literal, not env):
#
#   SQLite:        provider = "sqlite"      DATABASE_URL=file:./prisma/dev.db
#   PostgreSQL:    provider = "postgresql"  DATABASE_URL=postgresql://user:pass@localhost:5432/ilink?schema=public
#   MySQL:         provider = "mysql"       DATABASE_URL=mysql://user:pass@localhost:3306/ilink
#
# After switching, run `npm run db:push` (or `npm run db:migrate`) to apply.
DATABASE_URL="file:./prisma/dev.db"

# --- iLink SDK ---------------------------------------------------------------
# The @wechatbot/wechatbot SDK talks directly to the WeChat iLink Bot API.
# Credentials (bot_token, ilink_bot_id, ilink_user_id) are auto-persisted
# to ILINK_STORAGE_DIR/credentials.json after the first successful scan.
ILINK_BASE_URL="https://ilinkai.weixin.qq.com"
ILINK_STORAGE_DIR="~/.wechatbot"
ILINK_LOG_LEVEL="info"

# --- Router Behavior ----------------------------------------------------------
# Command prefix. Default is "!".
COMMAND_PREFIX="!"

# Default channel alias used when a user has not switched yet (leave empty = no default).
DEFAULT_CHANNEL_ALIAS=""

# Forwarding timeout for upstream HTTP webhook calls (ms).
FORWARD_TIMEOUT_MS=30000

# --- Optional Redis Cache -----------------------------------------------------
# Leave empty to disable. Used for session caching in multi-instance deployments.
REDIS_URL=""

# --- Server ------------------------------------------------------------------
PORT=3000
NODE_ENV="development"

# Auth token for the admin API (leave empty in dev to disable).
ADMIN_TOKEN=""

# Webhook auth: when set, requests sent to upstream channels include
# `X-ILink-Key: <UPSTREAM_WEBHOOK_SECRET>` so upstreams can verify the caller.
UPSTREAM_WEBHOOK_SECRET=""
